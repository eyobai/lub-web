# Address of the backend API, without a trailing slash and without /api/v1.
# The backend must list this site's address in its CORS_ORIGINS setting.
VITE_API_BASE_URL=http://localhost:3000
# Use "/" when a reverse proxy serves the API from the site's own address (no CORS needed).
# Locally: VITE_API_BASE_URL=/ API_PROXY_TARGET=http://localhost:3000 npm run dev
# Against the live backend: VITE_API_BASE_URL=/ API_PROXY_TARGET=https://api.leyubid.com npm run dev
